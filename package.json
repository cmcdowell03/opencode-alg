{
  "name": "opencode-alg",
  "version": "0.1.0",
  "description": "Agents + Loops + Graphs runtime for OpenCode — typed DAG, fresh-child checker, durable runs, session-tree execution",
  "type": "module",
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts"
  },
  "opencode": {
    "server": "./src/server.ts",
    "tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "agents",
    "templates",
    "docs",
    "scripts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "bun test --timeout 15000",
    "test:installer": "bun test tests/installer.test.ts",
    "test:tui": "bun test tests/tui.test.ts",
    "smoke": "bun run scripts/smoke.ts",
    "live:verify": "bun run scripts/live-verify.ts",
    "check:live": "bun run scripts/check-live.ts",
    "typecheck": "bun ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun run test && bun run smoke && bun run check:live"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "jsonc-parser": "3.3.1",
    "zod": "4.1.8"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agents",
    "graphs",
    "loops",
    "orchestration"
  ],
  "devDependencies": {
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.3",
    "@opentui/solid": "0.4.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.17.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
