{
  "name": "opencode-alg",
  "version": "0.3.0",
  "description": "Agents + Loops + Graphs runtime for OpenCode — typed DAG, fresh-child checker, durable runs, session-tree execution",
  "type": "module",
  "license": "MIT",
  "engines": {
    "opencode": ">=1.18.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts"
  },
  "opencode": {
    "server": "./src/server.ts",
    "tui": "./src/tui.ts"
  },
  "opencodeAlg": {
    "durableState": {
      "format": "alg-run-state",
      "currentSchema": 2,
      "compatibleSchemas": [1, 2],
      "compatiblePackageVersions": ["0.1.0", "0.2.0", "0.3.0"]
    }
  },
  "files": [
    "src",
    "agents",
    "templates",
    "capabilities/excel/manifest.json",
    "capabilities/excel/policy.py",
    "capabilities/excel/pyproject.toml",
    "capabilities/excel/uv.lock",
    "capabilities/excel/workbook.py",
    "capabilities/excel/wrapper.py",
    "docs",
    "DESIGN.md",
    "CHANGELOG.md",
    "scripts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "alg": "bun run scripts/manager-cli.ts",
    "test": "bun test --timeout 60000",
    "test:installer": "bun test tests/installer.test.ts tests/manager.test.ts tests/manager-launchers.test.ts",
    "test:manager": "bun test tests/manager.test.ts tests/manager-launchers.test.ts",
    "test:tui": "bun test tests/tui.test.ts",
    "smoke": "bun run scripts/smoke.ts",
    "live:verify": "bun run scripts/live-verify.ts",
    "check:live": "bun run scripts/check-live.ts",
    "check:excel-manifest": "bun run scripts/verify-excel-manifest.ts",
    "release:gate": "bun run scripts/release-gate.ts",
    "typecheck": "bun ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun run test && bun run smoke && bun run check:live"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.3",
    "jsonc-parser": "3.3.1",
    "zod": "4.1.8"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agents",
    "graphs",
    "loops",
    "orchestration"
  ],
  "devDependencies": {
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.3",
    "@opentui/solid": "0.4.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.17.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
