.opencode/runs/
.opencode/model*.json
.opencode/**/*private*
.opencode/**/*receipt*
runs/
**/runs/

# Generated output and caches
out/
**/out/
output/
**/output/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.cache/
**/.cache/
cache/
**/cache/
tmp/
**/tmp/
temp/
**/temp/
*.tsbuildinfo
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/

# Logs and local/live verification evidence
*.log
*.log.*
live-verification*.json
**/live-verification*.json
live-verification*/
**/live-verification*/
verification-evidence*/
