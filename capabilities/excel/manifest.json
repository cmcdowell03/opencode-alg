    }
  },
  "security": {
    "root_environment": "ALG_EXCEL_ROOT",
    "workbook_extension": ".xlsx",
    "relative_workbook_arguments_only": true,
    "path_argument_confinement": true,
    "os_sandbox": false,
    "ambient_process_permissions": true,
    "remote_transports": false,
    "staged_copies": true,
    "formula_calculation": false,
    "libreoffice_recalculation": false
  },
  "runtime": {
    "transport": "stdio",
    "sync": ["uv", "sync", "--frozen", "--no-dev"]
  }
